# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Données métier : Supabase Auth reste utilisé pour les sessions et mots de passe.
# Basculer à neon uniquement après migration et validation du service Data API.
DATABASE_PROVIDER=supabase
NEON_DATA_API_URL=
# Connexion pooled pour les outils applicatifs ; jamais utilisée pour contourner la RLS.
DATABASE_URL=
# Connexion directe pour migrations et sauvegardes, jamais une URL -pooler.
DATABASE_URL_UNPOOLED=
# Source PostgreSQL requise uniquement pour effectuer une migration récente.
SUPABASE_DATABASE_URL=

# Connexions d'apps OAuth (facultatif) : clé API de l'environnement Nango.
# À conserver uniquement côté serveur, jamais dans une variable NEXT_PUBLIC_.
# Configurer les intégrations et leurs clients OAuth dans https://app.nango.dev
NANGO_SECRET_KEY=

# IA gratuite — au moins une des deux clés.
# Groq : https://console.groq.com/keys (fournisseur principal)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# Gemini : https://aistudio.google.com/apikey (secours automatique)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
