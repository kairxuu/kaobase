# Neon Auth et Data API (serveur uniquement)
NEON_AUTH_BASE_URL=https://votre-endpoint.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=
# Secret aléatoire de 32 caractères minimum ; ne jamais le publier.
NEON_AUTH_COOKIE_SECRET=
NEON_DATA_API_URL=https://votre-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
APP_ORIGIN=https://kaobase.vercel.app
# Administration uniquement : jamais embarqués dans le navigateur ou iOS.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Connexions d'apps OAuth (facultatif) : clé API de l'environnement Nango.
# À conserver uniquement côté serveur, jamais dans une variable NEXT_PUBLIC_.
# Configurer les intégrations et leurs clients OAuth dans https://app.nango.dev
NANGO_SECRET_KEY=

# IA gratuite — au moins une des deux clés.
# Groq : https://console.groq.com/keys (fournisseur principal)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# Gemini : https://aistudio.google.com/apikey (secours automatique)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
